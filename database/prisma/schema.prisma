//============================================
// 1 configurando o gerador do prisma client
//============================================
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

//============================================
// 2 enums
//============================================

//============status da tarefa================
enum taskStatus{
  PENDING
  IN_PROGRESS
  COMPLETED
  DONE
}
//============prioridade da tarefa============
enum taskPriority{
  LOW
  MEDIUM
  HIGH
}

