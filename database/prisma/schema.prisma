//============================================
// 1 configurando o gerador do prisma client
//============================================
generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

//============================================
// 2 enums
//============================================

//============status da tarefa================
enum taskStatus{
  PENDING
  IN_PROGRESS
  COMPLETED
  DONE
}
//============prioridade da tarefa============
enum taskPriority{
  LOW
  MEDIUM
  HIGH
}

//============================================
// 3 modelo user
//============================================
model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  tasks     Task[]
  assigned  TaskAssignment[]
  comments  Comment[]

  @@map("users")
}

//============================================
// 4 modelo task
//============================================

